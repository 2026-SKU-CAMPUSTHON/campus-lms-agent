# Copy to .env.production (chmod 600). Never commit the filled file.
# APP_HOST is a hostname pointing to the Oracle instance, without https:// or a path.
APP_HOST=
# Generate URL-safe random passwords: openssl rand -hex 32
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
TYPESAFE_API_KEY=
JEV_MODEL=jev-1.13.0
JEV_MIN_CONFIDENCE=0.75
WHISPER_MODEL=small
# Initial operator account. Clear both EMAIL and PASSWORD after the first deployment.
BOOTSTRAP_EMAIL=
BOOTSTRAP_PASSWORD=
BOOTSTRAP_NAME=담당 교수
BOOTSTRAP_COURSE=팀 테스트 강의
