{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://2026-sku-campusthon.github.io/campus-lms-agent/worker.schema.json",
  "title": "Ingestion worker contract draft-1",
  "oneOf": [
    {
      "$ref": "#/$defs/IngestionRequest"
    },
    {
      "$ref": "#/$defs/IngestionResult"
    }
  ],
  "$defs": {
    "IngestionRequest": {
      "type": "object",
      "properties": {
        "contract_version": {
          "const": "draft-1"
        },
        "kind": {
          "const": "ingestion.request"
        },
        "job_id": {
          "type": "string",
          "format": "uuid"
        },
        "course_id": {
          "type": "string",
          "format": "uuid"
        },
        "week_id": {
          "type": "string",
          "format": "uuid"
        },
        "material_id": {
          "type": "string",
          "format": "uuid"
        },
        "source_type": {
          "enum": [
            "document",
            "audio",
            "video"
          ]
        },
        "storage": {
          "type": "object",
          "properties": {
            "bucket": {
              "type": "string",
              "minLength": 1
            },
            "object_key": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "bucket",
            "object_key"
          ],
          "additionalProperties": false
        },
        "page_range": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "start": {
                  "type": "integer",
                  "minimum": 1
                },
                "end": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "start",
                "end"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "contract_version",
        "kind",
        "job_id",
        "course_id",
        "week_id",
        "material_id",
        "source_type",
        "storage",
        "page_range"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "source_type": {
                "const": "document"
              }
            }
          },
          "then": {
            "properties": {
              "page_range": {
                "type": "object"
              }
            }
          },
          "else": {
            "properties": {
              "page_range": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "IngestionResult": {
      "type": "object",
      "properties": {
        "contract_version": {
          "const": "draft-1"
        },
        "kind": {
          "const": "ingestion.result"
        },
        "job_id": {
          "type": "string",
          "format": "uuid"
        },
        "course_id": {
          "type": "string",
          "format": "uuid"
        },
        "week_id": {
          "type": "string",
          "format": "uuid"
        },
        "material_id": {
          "type": "string",
          "format": "uuid"
        },
        "status": {
          "enum": [
            "completed",
            "failed"
          ]
        },
        "segments": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "text",
              "slide_no",
              "start_sec",
              "end_sec"
            ],
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1
              },
              "slide_no": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1
              },
              "start_sec": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "end_sec": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              }
            }
          }
        },
        "error": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                },
                "retryable": {
                  "type": "boolean"
                }
              },
              "required": [
                "code",
                "message",
                "retryable"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "contract_version",
        "kind",
        "job_id",
        "course_id",
        "week_id",
        "material_id",
        "status",
        "segments",
        "error"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "completed"
              }
            }
          },
          "then": {
            "properties": {
              "error": {
                "type": "null"
              },
              "segments": {
                "minItems": 1
              }
            }
          },
          "else": {
            "properties": {
              "error": {
                "type": "object"
              },
              "segments": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    }
  }
}
