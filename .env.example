# 로컬 개발 전용. 실제 배포 전 Supabase Auth/DB 연동이 필요합니다.
ENABLE_DEMO_AUTH=true
PORT=3000
DATA_DIR=.data
PYTHON_BIN=python3
# 로컬에서는 기존 ChatGPT 로그인으로 Codex를 사용합니다.
AI_PROVIDER=codex
CODEX_BIN=codex
# 비우면 설치된 CLI 기본 모델을 사용합니다.
CODEX_MODEL=
# 서버 배포 시 AI_PROVIDER=openai로 바꾸고 별도 API 키를 설정합니다.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
# 이전 생성 제공자도 선택 가능하지만 기본값은 Codex입니다.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# 다음 개발 단계에서 사용합니다.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Jev 판단은 별도 TypeSafe API를 사용합니다. 키가 없으면 오류·재시도 상태로 남깁니다.
TYPESAFE_API_KEY=
JEV_MODEL=jev-1.13.0
# 사전 검증용 임시 기준. 한국어 평가 후 조정합니다.
JEV_MIN_CONFIDENCE=0.75
