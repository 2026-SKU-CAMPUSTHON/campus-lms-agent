# 로컬 체험 모드. 실제 계정은 ENABLE_DEMO_AUTH=false 및 MYSQL_URL을 설정합니다.
ENABLE_DEMO_AUTH=true
PORT=3000
DATA_DIR=.data
PYTHON_BIN=python3
# 기본 생성 모델은 Claude API입니다. 키는 서버에만 저장합니다.
AI_PROVIDER=claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Codex를 명시적으로 선택하면 기존 ChatGPT 로컬 로그인을 사용합니다.
CODEX_BIN=codex
# 비우면 설치된 CLI 기본 모델을 사용합니다.
CODEX_MODEL=
# 서버 배포 시 AI_PROVIDER=openai로 바꾸고 별도 API 키를 설정합니다.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
# 이전 퀴즈 생성 제공자도 명시적으로 선택할 수 있습니다.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# MySQL 8.4. URL의 비밀번호는 URL 인코딩합니다.
MYSQL_URL=
MYSQL_TLS=false
MYSQL_SSL_CA=
# 실제 배포: NODE_ENV=production, HTTPS 주소, ENABLE_DEMO_AUTH=false
APP_ORIGIN=
HOST=127.0.0.1
# 최초 교수 계정. 생성 후 PASSWORD는 지워도 계정이 유지됩니다.
BOOTSTRAP_EMAIL=
BOOTSTRAP_PASSWORD=
BOOTSTRAP_NAME=담당 교수
BOOTSTRAP_COURSE=팀 테스트 강의
# Jev 판단은 별도 TypeSafe API를 사용합니다. 키가 없으면 오류·재시도 상태로 남깁니다.
TYPESAFE_API_KEY=
JEV_MODEL=jev-1.13.0
# 사전 검증용 임시 기준. 한국어 평가 후 조정합니다.
JEV_MIN_CONFIDENCE=0.75

# 로컬 전사: worker/requirements-media.txt 및 ffmpeg 설치 필요. 최초 실행은 모델 다운로드가 필요합니다.
WHISPER_MODEL=small
WHISPER_LANGUAGE=auto
# 비우면 DATA_DIR/models에 공개 모델 가중치를 저장합니다.
WHISPER_CACHE_DIR=
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
# YouTube 기능은 Python 3.10 이상 + worker/requirements-youtube.txt가 필요합니다.
# 비우면 PYTHON_BIN을 사용합니다. YouTube 전용 가상 환경도 지정할 수 있습니다.
YOUTUBE_PYTHON_BIN=
